generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  clerkId   String     @unique
  email     String     @unique
  firstName String?
  lastName  String?
  createdAt DateTime   @default(now())
  role      UserRole   @default(CLIENT)
  cart      Cart?
  favorites Favorite[]
  orders    Order[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Float
  gender      Gender
  color       String
  colorHex    String      @default("#888888")
  stock       Int         @default(0)
  images      String[]
  sizes       String[]
  material    String?
  fit         String?
  isNew       Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  stockStatus StockStatus @default(NORMAL)
  category    String
  cartItems   CartItem[]
  favorites   Favorite[]
  orderItems  OrderItem[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [clerkId])

  @@unique([userId, productId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [clerkId])
  items     CartItem[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int     @default(1)
  size      String?
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, size])
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         String
  status         OrderStatus @default(pending)
  total          Float
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deliveryMethod String      @default("PICKUP")
  user           User        @relation(fields: [userId], references: [clerkId])
  items          OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  size      String?
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId, size])
}

enum UserRole {
  CLIENT
  ADMIN
}

enum StockStatus {
  NORMAL
  LOW
  CRITICAL
  OUT_OF_STOCK
}

enum Category {
  pantalon
  pull
  veste
  chemise
  accessoire
  parfum
}

enum Gender {
  men
  women
  unisex
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}
